# Copy this file to .env and fill in real values before starting the server.
# Never commit the real .env file to version control.

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The frontend origin allowed to call this API (CORS) and used to build
# Stripe redirect URLs. In production this is your real domain, e.g.
# https://app.healingwayz.com
APP_BASE_URL=http://localhost:5173

PORT=4000

# SQLite file location. The default (db/healingways.db) is fine for a first
# launch; point this at a persistent volume if your host's filesystem is
# ephemeral (e.g. some container platforms reset local disk on deploy).
DB_PATH=./db/healingways.db

# Where uploaded documents are stored on disk. See routes/documents.js for
# the swap point to move this to S3-compatible object storage later.
UPLOAD_DIR=./uploads

# From your Stripe dashboard (test mode keys start with sk_test_ / pk_test_).
# Leave blank to run the server with payments disabled (checkout requests
# will return a clear 501 instead of failing unpredictably).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
